# Configure le profil standalone-full.xml utilise par l'instance WildFly EduSuivi.
# Arreter WildFly avant d'executer ce script.
# Configure WildFly 42 pour EduSuivi : driver PostgreSQL + datasource EdusuiviDS.
# Ne pas executer si le datasource EdusuiviDS existe deja dans le profil cible.
# Parametres (variables d'environnement, aucune valeur sensible n'est codee en dur) :
#   EDUSUIVI_DB_URL  (defaut jdbc:postgresql://localhost:5432/edusuivi_db)
#   EDUSUIVI_DB_USER, EDUSUIVI_DB_PASSWORD
#   PG_DRIVER_JAR    chemin du jar du driver PostgreSQL
# PowerShell : & "$env:WILDFLY_HOME\bin\jboss-cli.bat" --file="wildfly\configure-wildfly.cli"
embed-server --server-config=standalone-full.xml --std-out=echo
module add --name=org.postgresql --resources=${env.PG_DRIVER_JAR} --dependencies=jakarta.api,jakarta.transaction.api
/subsystem=datasources/jdbc-driver=postgresql:add(driver-name=postgresql,driver-module-name=org.postgresql,driver-xa-datasource-class-name=org.postgresql.xa.PGXADataSource)
data-source add --name=EdusuiviDS --jndi-name=java:/EdusuiviDS --driver-name=postgresql --connection-url="${env.EDUSUIVI_DB_URL:jdbc:postgresql://localhost:5432/edusuivi_db}" --user-name="${env.EDUSUIVI_DB_USER}" --password="${env.EDUSUIVI_DB_PASSWORD}" --validate-on-match=true --background-validation=false --use-ccm=true
stop-embedded-server
